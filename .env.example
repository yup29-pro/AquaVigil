# Environment Configuration Template for AquaVigil
# Copy this file to .env and adjust values for your environment.

# Server configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Model configuration
MODEL_WEIGHTS_PATH=models/best.pt
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IOU_THRESHOLD=0.45
DEVICE=cpu  # 'cpu' or '0' (for GPU index 0)

# Optional Roboflow API configuration (if using Roboflow Python SDK)
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
